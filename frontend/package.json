{
  "name": "bretagne-carto-frontend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix --ignore-path .gitignore",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --max-warnings 0 --ignore-path .gitignore",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:kit": "vitest run src/config/site.spec.ts src/config/__tests__/mapConfig.spec.js src/components/Dashboard/__tests__/DashboardFooter.spec.ts src/utils/__tests__/codeInsee.spec.ts src/utils/__tests__/mapPopupDom.spec.js src/utils/matomoInit.spec.ts src/composables/useCookieConsent.spec.ts"
  },
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.5.0",
    "chartjs-chart-matrix": "^3.0.0",
    "chartjs-chart-sankey": "^0.14.0",
    "chartjs-chart-treemap": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "html-to-image": "^1.11.11",
    "maplibre-gl": "^5.7.1",
    "pinia": "^3.0.4",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-vue": "^4.2.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.45.0",
    "eslint-plugin-vue": "^9.15.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^4.4.0",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.5"
  }
}
