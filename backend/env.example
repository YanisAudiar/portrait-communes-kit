# =============================================================================
# Copier ce fichier en .env à la racine du dossier backend :
#   cp env.example .env
# Ne jamais commiter .env (secrets).
# =============================================================================

# --- PostgreSQL (obligatoire pour l’API) ---
PGHOST=localhost
PGDATABASE=portrait_communes
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme

# Schéma des vues métier (doit exister en base)
PGSCHEMA=_a_vues_portrait_commune

# SSL : laisser vide en local sans SSL. Exemple distant : PGSSLMODE=require
# Si certificat auto-signé : PGSSL_REJECT_UNAUTHORIZED=false
PGSSLMODE=
PGSSL_REJECT_UNAUTHORIZED=true

# --- GeoServer (carte) ---
# Soit une URL WFS, soit un GeoJSON local (kit sans GeoServer).
# Pas de repli vers une instance tierce.
GEOSERVER_URL=https://geoserver.example.org/geoserver/workspace/ows
GEOSERVER_NAMESPACE=workspace
GEOSERVER_COMMUNES_LAYER=communes

# Fichier GeoJSON (code_insee_concat, lib_com, geometry). Si renseigné, WFS n'est pas appelé.
# COMMUNES_GEOJSON_PATH=./data/sample-communes.geojson

# --- API Express ---
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# URL du frontend (CORS, génération PDF / liens) — Vite : souvent http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Origines autorisées CORS, séparées par des virgules (optionnel ; sinon logique par défaut selon NODE_ENV)
# Exemple : CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# En production : wildcard (*) interdit
# CORS_ORIGINS=

# Routes PDF (/api/pdf/*) : désactivées par défaut car l'export PDF n'est pas exposé dans l'UI
# (ENABLE_PDF_EXPORT=false dans frontend/src/config/featureFlags.ts).
# Ne passer à true qu'en même temps que le flag frontend, et après avoir borné la
# concurrence Puppeteer (un Chromium par requête, cf. docs/AUDIT_SECURITE.md).
# ENABLE_PDF_ROUTES=false

# Hôtes frontend autorisés pour la génération PDF Puppeteer (anti-SSRF, séparés par virgules)
# PDF_ALLOWED_FRONTEND_HOSTS=localhost,127.0.0.1,portrait.example.org

# Nombre de hops proxy de confiance pour rate-limit (0 = pas de proxy, 1 = reverse proxy)
# TRUST_PROXY=1

# Routes debug (non production uniquement) : token obligatoire si ENABLE_DEBUG_ROUTES=true
# ENABLE_DEBUG_ROUTES=false
# DEBUG_ROUTE_TOKEN=change-me-in-dev-only

# --- Cache mémoire (durée en millisecondes ; défaut code = 5 min si absent) ---
CACHE_TIMEOUT=300000

# Plafond d'entrées du cache : au-delà, éviction LRU (défaut code = 500).
# Sans plafond, un cache dont les clés dérivent d'entrées utilisateur croît
# sans limite jusqu'à épuiser la mémoire du processus.
# CACHE_MAX_ENTRIES=500

# Plafond rate-limit API (défaut 100 / 15 min). Compose démo : 1000.
# API_RATE_LIMIT_MAX=100

# --- Content Security Policy ---
# La CSP est servie en en-tête par helmet (backend/server.ts), en mode bloquant.
# L'origine de GEOSERVER_URL est ajoutée automatiquement à connect-src.
# Hôtes supplémentaires (Matomo auto-hébergé, tuiles, etc.), séparés par des virgules :
# CSP_CONNECT_SRC=https://stats.example.org
# CSP_SCRIPT_SRC=https://cdn.matomo.cloud
# CSP_REPORT_ONLY=true la passe en signalement seul : utile pour une première
# validation en pré-prod (vérifier la console navigateur : carte, polices, Matomo),
# à repasser en mode bloquant ensuite.
# CSP_REPORT_ONLY=false

# --- Logs : DEBUG, INFO, WARN, ERROR ---
LOG_LEVEL=INFO
